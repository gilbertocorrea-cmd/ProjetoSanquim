{
  "info": {
    "name": "Colegio Sanquim | Login e Gestao",
    "description": "Defina senhaDemo com a senha das contas de demonstracao. A pasta Gestao cria dados novos em cada execucao.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "senhaDemo",
      "value": ""
    },
    {
      "key": "tokenAluno",
      "value": ""
    },
    {
      "key": "tokenGestao",
      "value": ""
    },
    {
      "key": "professorId",
      "value": ""
    },
    {
      "key": "alunoId",
      "value": ""
    },
    {
      "key": "turmaId",
      "value": ""
    },
    {
      "key": "disciplinaId",
      "value": ""
    },
    {
      "key": "rodada",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login de Gestão",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@sanquim.br\",\n  \"senha\": \"{{senhaDemo}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login de Gestão retorna 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "    const login = pm.response.json();",
              "    pm.test(\"Perfil correto\", () => pm.expect(login.role).to.eql(\"ROLE_GESTAO\"));",
              "    pm.test(\"Token com validade\", () => {",
              "        pm.expect(login.token).to.be.a('string').and.not.empty;",
              "        pm.expect(Date.parse(login.expiraEm)).to.be.greaterThan(Date.now());",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
