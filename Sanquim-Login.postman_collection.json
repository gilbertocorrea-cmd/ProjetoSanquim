          }
        ]
      },
      "item": [
        {
          "name": "Login de Gestao para os cadastros",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sanquim.br\",\n  \"senha\": \"{{senhaDemo}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status esperado 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set(\"tokenGestao\", pm.response.json().token);",
                  "}"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"rodada\", String(Date.now()));",
                  "for (const key of [\"tokenGestao\", \"professorId\", \"alunoId\", \"turmaId\", \"disciplinaId\"]) {",
                  "    pm.collectionVariables.unset(key);",
                  "}"
                ]
              }
            }
          ]
        },
